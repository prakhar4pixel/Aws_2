# UrbanCool Frontend Environment Variables (All Optional)

# Backend API URL (defaults to http://localhost:8000/api)
VITE_API_BASE_URL=http://localhost:8000/api

# Optional: CARTO Enterprise API Key (leave empty for free public Voyager basemap)
VITE_CARTO_API_KEY=

# Optional: Custom Vector Basemap Style URL (e.g., Mapbox or MapTiler)
# VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_MAPTILER_KEY

# Optional: Mapbox Access Token (if using Mapbox tiles)
# VITE_MAPBOX_TOKEN=pk.YOUR_MAPBOX_TOKEN
